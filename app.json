{
  "expo": {
    "name": "Kini Chat",
    "slug": "kini-chat",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0068FF"
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a0840547-5591-4525-b9b0-8093000e994d"
      }
    },
    "android": {
      "package": "com.truongnn.kinichat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0068FF"
      }
    }
  }
}
